# RoofwiseBD Backend — Environment Variables Reference
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit .env to version control — it is excluded by .gitignore.

AUTH_MODE=supabase
ENVIRONMENT=production

# Supabase PostgreSQL Connection URL (aws-0 pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Auth Configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_HERE
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Cross-Domain Cookie Configuration (Required for Cloudflare Pages)
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# CORS Origins (Include Cloudflare Pages and custom domains)
BACKEND_CORS_ORIGINS=https://roofwisebd.pages.dev,https://roofwisebd.com,https://www.roofwisebd.com,http://localhost:5173,http://127.0.0.1:5173
BACKEND_CORS_ORIGIN_REGEX=^https://([a-zA-Z0-9_-]+\.)*(pages\.dev|roofwisebd\.com)$

# Frontend Base URL
FRONTEND_URL=https://roofwisebd.pages.dev
