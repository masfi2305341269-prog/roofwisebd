# RoofwiseBD — Environment Variables Reference
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — it is excluded by .gitignore.

# ============================================================
# APPLICATION ENVIRONMENT
# ============================================================
# Options: development | production
# Either ROOFWISE_ENV or ENVIRONMENT is recognized:
ROOFWISE_ENV=production
# ENVIRONMENT=production

# ============================================================
# SECURITY — ALL REQUIRED IN PRODUCTION
# ============================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# Must be true in production so JWT session cookies are HTTPS-only
COOKIE_SECURE=true

# SameSite cookie policy: lax (default) or none (required for cross-domain frontend/backend e.g. Cloudflare Pages)
COOKIE_SAMESITE=none

# Access token lifetime in minutes (default: 1440 = 24 hours)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# CORS — REQUIRED IN PRODUCTION
# ============================================================
# Comma-separated list of allowed HTTPS frontend origins.
# No wildcards. No localhost. No HTTP origins.
BACKEND_CORS_ORIGINS=https://roofwisebd.pages.dev,https://roofwisebd.com,https://www.roofwisebd.com

# Optional regex for dynamic preview branches (e.g. Cloudflare Pages preview deployments)
BACKEND_CORS_ORIGIN_REGEX=^https://([a-zA-Z0-9_-]+\.)*(pages\.dev|roofwisebd\.com)$

# ============================================================
# FRONTEND URL — REQUIRED FOR PASSWORD RESET EMAILS
# ============================================================
# Used to construct the reset link embedded in the password reset email.
# Must match your actual HTTPS frontend domain.
FRONTEND_URL=https://roofwisebd.pages.dev

# ============================================================
# SUPABASE AUTH INTEGRATION
# ============================================================
# Auth mode: "supabase" (recommended) or "legacy" (FastAPI HS256 JWT)
AUTH_MODE=supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_HERE
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ============================================================
# EMAIL / SMTP DELIVERY — REQUIRED FOR PASSWORD RESET
# ============================================================
# Supported providers: SendGrid (port 587), AWS SES, Mailgun, Postmark, etc.
# Port 587 uses STARTTLS. Port 465 uses implicit SSL.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY_HERE
EMAIL_FROM=noreply@roofwisebd.com

# ============================================================
# REDIS — OPTIONAL (for multi-worker production rate limiting)
# ============================================================
# If not set, falls back to in-memory rate limiter (single process only).
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# DATABASE
# ============================================================
# SQLite (suitable for development and low-traffic single-server deployments).
# For high-availability production, migrate to PostgreSQL.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost/roofwisebd
