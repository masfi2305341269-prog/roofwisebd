# Normalize line endings to LF in the repository
* text=auto eol=lf

# Force LF for shell scripts and config files
*.sh text eol=lf
Procfile text eol=lf

# Treat binary files as binary (no line-ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.db binary
*.sqlite3 binary
*.ubj binary
*.bin binary
*.keras binary
*.h5 binary
